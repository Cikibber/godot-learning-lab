# Copy to .env.local. Never commit real values.
# Local values come from `npx supabase status` (local-only demo keys).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public origin of this app; used for invite redirect links and origin checks.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# School privacy contact shown on /privacy. Replace before any live use.
SCHOOL_CONTACT_NAME=Koordinator Data Sekolah (contoh)
SCHOOL_CONTACT_EMAIL=privacy@school.example

# OPERATOR TOOLING ONLY (scripts/provision.ts, scripts/seed-demo.ts).
# Bypasses RLS. Never expose to the browser, never prefix with NEXT_PUBLIC_,
# and do not set it in the web app's hosting environment.
SUPABASE_SECRET_KEY=sb_secret_...
